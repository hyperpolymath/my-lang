;
; ENSAID_CONFIG.a2ml — PanLL configuration for the my-lang language project.
; my-lang is a custom programming language implemented in Rust.
; This portfolio focuses on language compiler/interpreter development.

; ─────────────────────────────────────────────────────────────────────
; [ensaid] — eNSAID environment identity
; ─────────────────────────────────────────────────────────────────────
[ensaid]
version = "1.0"
name = "my-lang-dev"
description = "Language development environment for the my-lang compiler"
humidity = "medium"
; Humidity: "dry" = symbolic-heavy, "medium" = balanced, "wet" = neural-heavy.
; Language development benefits from a balanced approach — formal type checking
; plus neural assistance for parser generation and test synthesis.

; ─────────────────────────────────────────────────────────────────────
; [workspace] — file watching, language detection, build integration
; ─────────────────────────────────────────────────────────────────────
[workspace]
root = "."
watch_extensions = [".rs", ".idr", ".zig", ".my", ".toml"]
; .my = my-lang source files, .rs = compiler implementation,
; .idr = ABI definitions, .zig = FFI bridge
ignore_patterns = ["target/", "build/", ".git/", "*.swp"]
editor = "vscodium"
; Default editor. PanLL supports: vscodium, neovim, jetbrains, brackets, notepad++
build_command = "cargo build"
test_command = "cargo test"
language_id = "rust"
; Primary implementation language. my-lang sources use language_id "my-lang" internally.

; ─────────────────────────────────────────────────────────────────────
; [preferences] — developer preferences and UI settings
; ─────────────────────────────────────────────────────────────────────
[preferences]
theme = "dark"
font_size = 14
show_line_numbers = true
auto_save = true
auto_format_on_save = true
tab_size = 4
panel_layout = "three-column"
; three-column = Panel-L (constraints) | Panel-N (agent) | Panel-W (results)

; ─────────────────────────────────────────────────────────────────────
; [panels] — which PanLL panels are enabled for this project
; ─────────────────────────────────────────────────────────────────────
[panels]
enabled = [
  "valence-shell",       ; Terminal + command execution
  "editor-bridge",       ; Editor integration (VSCodium, etc.)
  "build-dashboard",     ; Cargo build status + error navigation
  "boj",                 ; BoJ cartridge dashboard (for ABI/FFI work)
  "vm-inspector",        ; Runtime/VM inspection for my-lang interpreter
  "security",            ; Security scanning (Hypatia)
  "reposystem",          ; Repository management
  "panic-attack",        ; Error/panic analysis
  "tsdm",                ; Type System Design Mode — critical for language dev
]

disabled = [
  "database",            ; No database component in my-lang
  "network",             ; No network layer
  "container",           ; Container builds handled externally
  "fleet",               ; No gitbot fleet needed for single-repo work
]

; ─────────────────────────────────────────────────────────────────────
; [workflows] — project-specific workflow definitions
; ─────────────────────────────────────────────────────────────────────
[workflows]

[workflows.parse-test-on-save]
trigger = "file_save"
match = "*.my"
action = "run_command"
command = "cargo test -- --test-threads=1 parser"
description = "Run parser tests when my-lang source files change"

[workflows.typecheck-on-save]
trigger = "file_save"
match = "src/types.rs"
action = "run_command"
command = "cargo test -- types"
description = "Run type system tests when type checker changes"

[workflows.abi-verify]
trigger = "file_save"
match = "src/abi/*.idr"
action = "run_command"
command = "idris2 --check src/abi/Types.idr"
description = "Verify ABI definitions when Idris2 files change"

; ─────────────────────────────────────────────────────────────────────
; [clades] — panel clade taxonomy for this project
; ─────────────────────────────────────────────────────────────────────
[clades]
active = ["builder", "terminal", "scanner", "viewer", "bridge"]
; Language development uses builder (compilation), terminal (REPL),
; scanner (security), viewer (AST inspection), bridge (editor integration).

; ─────────────────────────────────────────────────────────────────────
; [portfolios] — named panel/workflow presets
; ─────────────────────────────────────────────────────────────────────
[portfolios]

[portfolios.compiler-dev]
description = "Full compiler development view"
panels = ["valence-shell", "editor-bridge", "build-dashboard", "tsdm", "panic-attack"]
layout = "three-column"
focus = "build-dashboard"

[portfolios.language-design]
description = "Language design and type system exploration"
panels = ["editor-bridge", "tsdm", "vm-inspector"]
layout = "three-column"
focus = "tsdm"

[portfolios.testing]
description = "Test-focused view with REPL"
panels = ["valence-shell", "build-dashboard", "panic-attack"]
layout = "two-column"
focus = "valence-shell"
