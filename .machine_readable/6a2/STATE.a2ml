# STATE.a2ml — My Lang project state
[metadata]
project = "my-lang"
version = "0.1.0"
last-updated = "2026-06-02"
status = "active"
session = "alignment + echo-types integration — 2026-06-02"

[project-context]
name = "My Lang"
purpose = """
Multi-dialect programming language with QTT (Quantitative Type Theory) semantic
core. Four dialects: solo (affine, single-agent), duet (session-typed, two-party),
ensemble (multi-agent), me (block/visual/pedagogic). Formal verification —
mechanised Coq + Idris2 solo-core — is a first-class deliverable alongside the
Rust compiler implementation.
"""
completion-percentage = 30

[position]
phase = "early-alpha"
maturity = "experimental"

[proof-status]
qtt-semiring-coq = "locally-checked"
qtt-semiring-idris2 = "locally-checked"
solo-syntax-contexts-typing = "definitions-only"
progress-preservation = "statement-only"
echo-type-former = "locally-checked"
paper-proofs = "proved-on-paper"
proof-ci = "absent"

[route-to-mvp]
