[project-context]
name = "My Lang"
purpose = """
Multi-dialect programming language with QTT (Quantitative Type Theory) semantic
core. Four dialects: solo (affine, single-agent), duet (session-typed, two-party),
ensemble (multi-agent), me (block/visual/pedagogic). Formal verification —
mechanised Coq + Idris2 solo-core — is a first-class deliverable alongside the
Rust compiler implementation.
"""
completion-percentage = 35

[position]
phase = "early-alpha"
maturity = "experimental"

[proof-status]
qtt-semiring-coq = "locally-checked"
qtt-semiring-idris2 = "locally-checked"
solo-syntax-contexts-typing = "locally-checked"
operational-semantics = "locally-checked"     # F1.1 — CBV step/Step committed both tracks
progress = "locally-checked"                   # F1.3 — Coq Qed (axiom-free); Idris total/hole-free
preservation = "statement-only"                # F1.4 — Coq Prop; Idris ?todo_preservation
echo-type-former = "locally-checked"           # Rust checker Ty::Echo + EchoMode/THEcho/THWeaken
echo-residue = "locally-checked"               # EchoResidue.{v,idr} backs Ty::is_assignable_from
paper-proofs = "proved-on-paper"
proof-ci = "absent"                            # ROOT GAP — see issue + F5; echo-types has agda.yml, my-lang has none

[echo-integration]
# echo-types is now a first-class feature of the FORMAL type system, not only the
# Rust checker. Kernel: TEcho type former + MkEcho/Weaken terms + THEcho/THWeaken
# rules + echo reductions; progress covers them. EchoMode = Linear/Affine thin
# poset (weaken + no-section laws). EchoResidue = proof-layer object (slice 3 of
# docs/design/echo-types-integration.md) pinning the laws behind the Rust
# Ty::is_assignable_from Echo case. 5/5 Rust echo_tests are exactly these laws.
slice-1-checker = "done"      # PR #86
slice-3-proof-layer = "done"  # PR #92 (this session)
slice-2-parser-syntax = "pending"

