[metadata]
project = "my-lang"
version = "0.1.0"
last-updated = "2026-06-14"
status = "active"
session = "F1.4 preservation + QTT substitution lemma proved (Coq, axiom-free) via separated tctx+uvec context and both products (additive & + multiplicative ⊗); Echo in the formal kernel — 2026-06-14"

[project-context]
name = "My Lang"
purpose = """
Multi-dialect programming language with QTT (Quantitative Type Theory) semantic
core. Three NESTED dialects: Solo (affine, single-agent) ⊂ Duet (session-typed,
two-party) ⊂ Ensemble (multi-agent). "Me" is NOT a fourth dialect — it is an
on-the-fly, agent-generated PROJECTION over the dialect hierarchy (specified in
tentacles-agentic-syllabus/me/README.adoc), not a static compiler. Formal
verification — mechanised Coq + Idris2 solo-core — is a first-class deliverable
alongside the Rust compiler implementation.
"""
completion-percentage = 42

[position]
phase = "early-alpha"
maturity = "experimental"

[proof-status]
qtt-semiring-coq = "locally-checked"
qtt-semiring-idris2 = "locally-checked"
solo-syntax-contexts-typing = "locally-checked"   # separated tctx+uvec context; additive & (TWith) + multiplicative ⊗ (TTensor) products; Echo former
operational-semantics = "locally-checked"     # F1.1 — CBV step/Step committed both tracks
progress = "locally-checked"                   # F1.3 — Coq Qed (axiom-free); Idris twin pending
preservation = "locally-checked"               # F1.4 — Coq Theorem Qed (axiom-free) via open-context subst lemma ht_subst; Idris twin ?todo_preservation
echo-type-former = "locally-checked"           # Rust checker Ty::Echo + EchoMode/THEcho/THWeaken
echo-residue = "locally-checked"               # EchoResidue.{v,idr} backs Ty::is_assignable_from
paper-proofs = "proved-on-paper"
proof-ci = "absent"                            # ROOT GAP — see issue + F5; echo-types has agda.yml, my-lang has none

[context-and-products]
# F1.4-prerequisite kernel refactor (2026-06-12..13). The earlier conflated QTT
# context (types+quantities in one Snoc, ctx_add taking its type from the FIRST
# argument — not commutative in types) is replaced by a SEPARATED context: a
# type context tctx (TEmpty/TSnoc, shared verbatim across every premise) and a
# usage vector uvec (UEmpty/USnoc, the thing that splits via uadd / scales via
# uscale). uadd is now genuinely commutative + associative (uadd_comm,
# uadd_assoc, uscale_add in Usage.v) — the clean algebra the substitution lemma
# leans on. Products: the old single incoherent product (split-intro + project-
# elim, neither & nor ⊗) is replaced by BOTH the additive & (TWith — shared
# usage, Fst/Snd projection) and the multiplicative ⊗ (TTensor — split usage,
# let (x,y)=e let-pair eliminator with two-variable subst2). Additive-& is eager
# (type-safe; observationally = lazy under strong normalisation; lazy deferred to
# when recursion/effects land).
separated-context = "done"    # PRs #102 (Usage.v) + #103 (migration)
additive-product = "done"     # PR #103 (TWith, &)
multiplicative-product = "done" # PR #104 (TTensor, ⊗)

[echo-integration]
# echo-types is now a first-class feature of the FORMAL type system, not only the
# Rust checker. Kernel: TEcho type former + MkEcho/Weaken terms + THEcho/THWeaken
# rules + echo reductions; progress AND preservation cover them. EchoMode =
# Linear/Affine thin poset (weaken + no-section laws). EchoResidue = proof-layer
# object (slice 3 of docs/design/echo-types-integration.md) pinning the laws
# behind the Rust Ty::is_assignable_from Echo case. 5/5 Rust echo_tests are
# exactly these laws.
slice-1-checker = "done"      # PR #86
slice-3-proof-layer = "done"  # PR #92
slice-2-parser-syntax = "pending"

