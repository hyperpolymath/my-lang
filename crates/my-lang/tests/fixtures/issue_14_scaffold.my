}

fn build_project(name: String) -> String {
    let header = scaffold_1(name, "v1", "crate");
    let body = str_concat(scaffold_2(header, "mod", "main"), scaffold_3(name, "lib", "api"));
    let manifest = format(str_concat(header, str_concat(body, scaffold_4(name, "dep", "core"))));
    let doc = str_concat(manifest, str_concat(scaffold_5(name, "readme", "intro"), scaffold_6(body, "usage", "end")));
    let out = str_concat(header, str_concat(body, str_concat(manifest, str_concat(doc, scaffold_7(name, "foot", "eof")))));
    return out;
}

fn main() -> Int {
    let project = build_project("demo");
    let report = str_concat("built:", str_concat(project, format(project)));
    return 0;
}
