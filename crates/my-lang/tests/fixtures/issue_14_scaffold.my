//
// Reconstructed reproduction for hyperpolymath/my-lang#14 (follow-up to #1/#12).
//
// The original ~330 LOC scaffold tool that triggered the 16-32 GiB Windows
// allocation was never attached to the issue. This file rebuilds the *shape*
// the report describes: a code-scaffolding tool whose output is assembled
// almost entirely from nested str_concat / format string-building
// constructs, with many independent templating sites ("aggregate complexity
// of nested string-building constructs") and moderate per-expression nesting
// kept well below the #12 MAX_EXPR_DEPTH guard so it represents a
// deep-but-otherwise-legal program, not a pathological depth bomb.

fn scaffold_1(a: String, b: String, c: String) -> String {
    let part = str_concat(a, str_concat(b, c));
    let wrapped = format(str_concat("<", str_concat(part, ">")));
    let line = str_concat(wrapped, str_concat(" | ", str_concat(a, str_concat(b, c))));
    let deep = str_concat("L0:", str_concat(line, str_concat("L1:", str_concat(part, str_concat("L2:", str_concat(wrapped, "end"))))));
    return str_concat(deep, format(str_concat(line, part)));
}

